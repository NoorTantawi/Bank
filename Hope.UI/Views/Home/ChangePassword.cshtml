@model Hope.infrastructure.DTO.ChangePasswordDTO

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Change Password</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        .user-box {
            position: relative;
            margin-bottom: 30px;
        }

        .form-control {
            width: 100%;
            padding: 10px 40px 10px 10px; /* increase right padding to make space for eye */
            font-size: 16px;
            color: #333;
            border: none;
            border-bottom: 2px solid #333;
            outline: none;
            background: transparent;
        }

        .password-toggle-icon {
            position: absolute;
            top: 50%;
            right: 10px;
            transform: translateY(-50%);
            cursor: pointer;
            z-index: 10;
            height: 100%;
            display: flex;
            align-items: center;
        }

            .password-toggle-icon i {
                font-size: 18px;
                color: #333;
                line-height: 1;
            }

    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title fw-semibold mb-4">Change Password</h5>
                    <div class="card">
                        <div class="card-body">
                            <form asp-action="Change">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label class="form-label">New Password <span class="text-danger">*</span></label>
                                        <div class="user-box">
                                            <input id="txtNewPassword" type="password" class="form-control" asp-for="NewPassword" />
                                            <span class="password-toggle-icon"><i id="toggleNew" class="fas fa-eye"></i></span>
                                        </div>
                                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Confirm Password <span class="text-danger">*</span></label>
                                        <div class="user-box">
                                            <input id="txtConfirmPassword" type="password" class="form-control" asp-for="ConfirmPassword" />
                                            <span class="password-toggle-icon"><i id="toggleConfirm" class="fas fa-eye"></i></span>
                                        </div>
                                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4">
                                        <button id="btnSubmit" type="submit" class="btn btn-primary">Change</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const newPassword = document.getElementById("txtNewPassword");
        const toggleNew = document.getElementById("toggleNew");

        toggleNew.addEventListener("click", function () {
            if (newPassword.type === "password") {
                newPassword.type = "text";
                toggleNew.classList.remove("fa-eye");
                toggleNew.classList.add("fa-eye-slash");
            } else {
                newPassword.type = "password";
                toggleNew.classList.remove("fa-eye-slash");
                toggleNew.classList.add("fa-eye");
            }
        });

        const confirmPassword = document.getElementById("txtConfirmPassword");
        const toggleConfirm = document.getElementById("toggleConfirm");

        toggleConfirm.addEventListener("click", function () {
            if (confirmPassword.type === "password") {
                confirmPassword.type = "text";
                toggleConfirm.classList.remove("fa-eye");
                toggleConfirm.classList.add("fa-eye-slash");
            } else {
                confirmPassword.type = "password";
                toggleConfirm.classList.remove("fa-eye-slash");
                toggleConfirm.classList.add("fa-eye");
            }
        });
    </script>

    @section Scripts {
        @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    }
</body>
</html>
